# mount point       fstype    device                                                                flags
/system_root        ext4      system                                                                display="System";logical;slotselect
/vendor             ext4      vendor                                                                display="Vendor";logical;slotselect
/product            ext4      product                                                               display="Product";logical;slotselect
/system_ext         ext4      system_ext                                                            display="System_EXT";logical;slotselect
/metadata           ext4      /dev/block/platform/bootdevice/by-name/metadata                       display="Metadata"
/data               f2fs      /dev/block/platform/bootdevice/by-name/userdata                       fileencryption=aes-256-xts:aes-256-cts:v1;keydirectory=/metadata/vold/metadata_encryption
/boot               emmc      /dev/block/platform/bootdevice/by-name/boot                           display="Boot";slotselect;flashimg=1
/Para               emmc      /dev/block/platform/bootdevice/by-name/para                           display="para"
/misc               emmc      /dev/block/platform/bootdevice/by-name/misc                           display="misc"
/persistent         emmc      /dev/block/platform/bootdevice/by-name/frp                            display="FRP"
/usb_otg            vfat      /dev/block/sda1                    /dev/block/sda                     flags=display="USB-OTG";storage;wipeingui;removable
