# Android V2 fstab for Infinix X6512 (MT6761)
#<src>                                                  <mnt_point>         <type>    <mnt_flags and options>                             <fs_mgr_flags>
system                                                  /system             ext4      ro,barrier=1                                        wait,logical,first_stage_mount,slotselect
vendor                                                  /vendor             ext4      ro,barrier=1                                        wait,logical,first_stage_mount,slotselect
product                                                 /product            ext4      ro,barrier=1                                        wait,logical,first_stage_mount,slotselect
system_ext                                              /system_ext         ext4      ro,barrier=1                                        wait,logical,first_stage_mount,slotselect
/dev/block/by-name/metadata                             /metadata           ext4      noatime,nosuid,nodev,discard                        wait,check,formattable
/dev/block/by-name/userdata                             /data               f2fs      noatime,nosuid,nodev,discard,inline_xattr_size=60   wait,check,formattable,latemount,fileencryption=aes-256-xts:aes-256-cts:v1,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/boot                                 /boot               emmc      defaults                                            slotselect
/dev/block/by-name/para                                 /para               emmc      defaults                                            defaults
/dev/block/by-name/misc                                 /misc               emmc      defaults                                            defaults
/dev/block/by-name/frp                                  /persistent         emmc      defaults                                            defaults
